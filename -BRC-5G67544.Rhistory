my.render.cat <- function(x, ...) {
# Frequency and proportion
tbl <- table(x)
pct <- prop.table(tbl) * 100
# Apply suppression: if count < 5, display "<5"
out <- ifelse(tbl < 5,
"<5",
sprintf("%d (%.1f%%)", tbl, pct))
}
